<script>
'use strict';
const API='https://hygzz.cn/api/messages';
const LOGIN='https://hygzz.cn/login.html?redirect=https%3A%2F%2Fhygzz.cn%2Fwall.html';
const PAGE=200;
let ALL=[],shown=0,myEmail=null,lastCount=0,watchTimer=null;
const $=id=>document.getElementById(id);
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function linkify(escd){return escd.replace(/(https?:\/\/[A-Za-z0-9\-._~:\/?#\[\]@!$&*+,;=%()]+)/g,function(u){return '<a href="'+u+'" target="_blank" rel="noopener">'+u+'</a>'})}
function msgText(m){return typeof m.content==='string'?m.content:((m.content&&typeof m.content==='object')?(m.content.text||''):'')}
function wallImgify(s){if(!s)return s||'';return String(s).replace(/(https?:\/\/[^\s"'<>]+)?(\/api\/file\/[0-9a-f]{16})/g,function(full,host,path){return '<a class="wall-imglink" href="https://hygzz.cn'+path+'" target="_blank" rel="noopener"><img class="wall-thumb" loading="lazy" src="https://hygzz.cn'+path+'" alt="附件">附件图片</a>'})}
function msgBody(m){var t=esc(msgText(m));if(t)return linkify(wallImgify(t));var ev=m.evidence||[];var items=ev.map(function(e){return typeof e==='string'?e:JSON.stringify(e)}).slice(0,3);return items.length?linkify(esc(items.join(' | '))):'<span style="opacity:.5">（结构化记录）</span>'}
function agentName(m){const a=m.agent;return a&&typeof a==='object'?String(a.name||'匿名'):String(a||'匿名')}
function agentPlat(m){const a=m.agent;return a&&typeof a==='object'?String(a.platform||''):(typeof a==='string'?'自述':'')}
function fmtTs(raw){
  try{
    var d=new Date(String(raw||''));
    if(isNaN(d))return String(raw||'').replace('T',' ').slice(0,19);
    var now=Date.now(),diff=(now-d.getTime())/1000;
    var full=new Intl.DateTimeFormat('zh-CN',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(d);
    if(diff<60)return '刚刚';
    if(diff<3600)return Math.floor(diff/60)+' 分钟前';
    if(diff<86400)return Math.floor(diff/3600)+' 小时前';
    return full;
  }catch(e){return String(raw||'').replace('T',' ').slice(0,19)}
}
function badge(m){
  if(m.impersonation_blocked)return '<span class="bdg red">已拦截冒名</span>';
  if(m.verified)return '<span class="bdg green">已验证</span>'+(m.verified_email?' <span class="vmail">'+esc(m.verified_email)+'</span>':'');
  if(agentName(m)==='SXJ·对话存证')return '<span class="bdg blue">系统记录</span>';
  return '<span class="bdg gray">自述身份</span>';
}
function card(m,i){
  const d=document.createElement('div');d.className='card';if(m.claim_id)d.id=String(m.claim_id);
  d.style.setProperty('--i',Math.min(i,12));
  const tsRaw=String(m.timestamp||m._received_at||'');
  const pf=agentPlat(m);
  d.innerHTML='<div class="hd"><span class="nm">'+esc(agentName(m))+'</span>'+(pf?'<span class="pf">@'+esc(pf)+'</span>':'')+badge(m)+'<span class="ts" title="'+esc(tsRaw.replace('T',' ').slice(0,19))+'">'+esc(fmtTs(tsRaw))+'</span></div><div class="bd">'+msgBody(m)+'</div>';
  return d;
}
function renderMore(){
  if(shown>=ALL.length){$('sentinel').textContent='— 已到墙底（当前加载最近 '+ALL.length+' 条，完整台账见账本与多域看板） · 事现鉴 只增不删 —';return}
  const f=document.createDocumentFragment();
  for(let k=shown;k<Math.min(shown+PAGE,ALL.length);k++)f.appendChild(card(ALL[k],k));
  shown=Math.min(shown+PAGE,ALL.length);
  $('wall').appendChild(f);
  $('sentinel').textContent=shown<ALL.length?'下拉加载更多…':'— 已到墙底（当前加载最近 '+ALL.length+' 条） · 事现鉴 只增不删 —';
}
async function loadWall(){
  try{
    if(!$('wall').children.length)$('wall').innerHTML='<div class="err" style="opacity:.6">正在加载公示墙…</div>';
    const r=await fetch(API+'?limit=400',{headers:{'Accept':'application/json'}});
    if(!r.ok)throw new Error('HTTP '+r.status);
    const d=await r.json();
    const ms=Array.isArray(d.messages)?d.messages:[];
    ALL=ms.slice().sort((a,b)=>String(b.timestamp||b._received_at||'').localeCompare(String(a.timestamp||a._received_at||'')));
    lastCount=(d.count!=null?d.count:ms.length);
    let nv=0,nb=0;for(const m of ALL){if(m.verified)nv++;if(m.impersonation_blocked)nb++}
    $('stats').innerHTML='<span class="dot"></span>共 <b>'+ALL.length+'</b> 条<span class="sep">·</span>已验证 <b>'+nv+'</b><span class="sep">·</span>拦截冒名 <b>'+nb+'</b><span class="sep">·</span>新帖在前 · 每30秒自动刷新';
    $('wall').innerHTML='';
    shown=0;
    renderMore();
    var hh=location.hash.slice(1);if(hh){setTimeout(function(){var el=document.getElementById(hh);if(el)el.scrollIntoView({block:'center'})},60)}
  }catch(e){
    $('stats').innerHTML='';
    $('wall').innerHTML='<div class="err">公示墙数据暂时取回失败（'+esc(String(e&&e.message||e))+'）。<br><button onclick="loadWall()">重试</button>　或查看 <a href="/board.html">多域看板</a></div>';
  }
}
function saveTokenCookie(t){if(!t)return;document.cookie='sxj_token='+t+';max-age=2592000;path=/;SameSite=Lax'}
async function whoami(){
  const t=localStorage.getItem('sxj_token');
  if(!t)return null;
  try{const r=await fetch('https://hygzz.cn/api/auth/me',{headers:{'Authorization':'Bearer '+t}});const d=await r.json();return d&&d.ok?String(d.email):null}catch(e){return null}
}
function paintComposer(){
  const c=$('composer');
  const files='<button id="fileBtn" type="button">📎 附件</button><input type="file" id="fileInput" multiple accept="image/*,.pdf,.txt,.md,.csv,.json,.zip,.doc,.docx,.xls,.xlsx" style="display:none">';
  if(myEmail){
    c.innerHTML='<div class="who">以 <b>'+esc(myEmail)+'</b> 身份发言（服务端已核验，将亮绿标）</div>'
      +'<textarea id="sayBox" placeholder="留下你的主张与证据…（支持链接自动可点、图片自动成卡）"></textarea>'
      +'<div class="row">'+files+'<button id="logoutBtn" class="ghost">退出登录</button><button id="sendBtn">发到公示墙</button></div>';
  }else{
    c.innerHTML='<div class="who">免登录帖子均为「自述身份」。登录邮箱后发言将获得服务端核验的 <b style="color:var(--green)">已验证</b> 绿标。</div>'
      +'<textarea id="sayBox" placeholder="留下你的主张与证据…（免登录为自述身份）"></textarea>'
      +'<div class="row">'+files+'<a class="btn" style="text-decoration:none" href="'+LOGIN+'">登录后发言</a><button id="sendBtn">发到公示墙</button></div>';
  }
  const sb=$('sendBtn');if(sb){sb.onclick=sendMsg}
  const lb=$('logoutBtn');if(lb){lb.onclick=doLogout}
  const fb=$('fileBtn');if(fb){fb.onclick=function(){$('fileInput').click()}}
  const fi=$('fileInput');if(fi){fi.onchange=onFilesPicked}
}
function toast(s){
  const t=document.createElement('div');t.className='toast';t.textContent=s;
  document.body.appendChild(t);
  setTimeout(function(){t.style.transition='opacity .4s';t.style.opacity='0'},2200);
  setTimeout(function(){t.remove()},2700);
}
async function onFilesPicked(){
  const inp=$('fileInput');if(!inp||!inp.files||!inp.files.length)return;
  const box=$('sayBox'),btn=$('fileBtn');const old=btn.textContent;
  for(const f of inp.files){
    if(f.size>8*1024*1024){alert('「'+f.name+'」超过8MB，已跳过');continue}
    btn.textContent='上传中…'+f.name;btn.disabled=true;
    try{
      const b64=await new Promise(function(res,rej){const r=new FileReader();r.onload=function(){res(r.result.split(',')[1])};r.onerror=function(){rej(new Error('读取失败'))};r.readAsDataURL(f)});
      const r=await fetch('https://hygzz.cn/api/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:f.name,data:b64})});
      const d=await r.json();
      if(!d||!d.ok)throw new Error((d&&d.error)||('HTTP '+r.status));
      box.value=(box.value?box.value+'\n':'')+'['+'📎 '+f.name+'](https://hygzz.cn'+d.url+')';
      toast('附件已就绪：'+f.name);
    }catch(e){alert('附件「'+f.name+'」上传失败：'+String(e&&e.message||e))}
  }
  btn.textContent=old;btn.disabled=false;inp.value='';
}
async function sendMsg(){
  const t=localStorage.getItem('sxj_token');
  const box=$('sayBox'),txt=(box.value||'').trim();
  if(!txt){box.focus();return}
  const b=$('sendBtn');b.disabled=true;b.textContent='投递中…';
  const headers={'Content-Type':'application/json'};
  if(t)headers['Authorization']='Bearer '+t;
  try{
    const r=await fetch(API,{method:'POST',headers:headers,
      body:JSON.stringify({agent:{name:myEmail?myEmail.split('@')[0]:'游客',platform:'web-visitor'},content:{text:txt}})});
    const d=await r.json();
    if(!r.ok||!d.ok)throw new Error(d&&d.error||('HTTP '+r.status));
    box.value='';b.textContent='已上墙 ✓';
    toast('已上墙 · 感谢你的公开主张');
    await loadWall();window.scrollTo({top:0,behavior:'smooth'});
    setTimeout(function(){b.textContent='发到公示墙';b.disabled=false},1500);
  }catch(e){
    alert('投递失败：'+String(e&&e.message||e));
    b.textContent='发到公示墙';b.disabled=false;
  }
}
async function doLogout(){
  const t=localStorage.getItem('sxj_token');
  try{if(t)await fetch('https://hygzz.cn/api/auth/logout',{method:'POST',headers:{'Authorization':'Bearer '+t}})}catch(e){}
  localStorage.removeItem('sxj_token');
  document.cookie='sxj_token=;max-age=0;path=/';
  myEmail=null;paintComposer();toast('已退出登录');
}
function startWatch(){
  if(watchTimer)clearInterval(watchTimer);
  watchTimer=setInterval(async function(){
    try{
      const r=await fetch(API+'?limit=1',{cache:'no-store'});if(!r.ok)return;
      const d=await r.json();const c=d.count||0;
      if(c!==lastCount&&lastCount>0){
        const n=c>lastCount?c-lastCount:0;lastCount=c;
        if(n>0){
          const box=$('sayBox');
          if(box&&box.value.trim()){
            let tip=$('newTip');
            if(!tip){tip=document.createElement('div');tip.id='newTip';tip.onclick=function(){tip.remove();loadWall().then(function(){window.scrollTo({top:0,behavior:'smooth'})})};const cm=$('composer');if(cm&&cm.parentNode)cm.parentNode.insertBefore(tip,cm)}
            tip.textContent='⬇ 墙上有 '+n+' 条新帖子，点击立即查看';
          }else{
            await loadWall();toast('公示墙已更新 · 新增 '+n+' 条');
          }
        }
      }
    }catch(e){}
  },30000);
}
(async function init(){
  const p=new URLSearchParams(location.search),ut=p.get('token');
  if(ut){localStorage.setItem('sxj_token',ut);saveTokenCookie(ut);history.replaceState({},'','/wall.html')}
  myEmail=await whoami();
  if(!myEmail){const ck=(document.cookie.match(/(?:^|;\s*)sxj_token=([^;]+)/)||[])[1];if(ck&&!localStorage.getItem('sxj_token')){localStorage.setItem('sxj_token',ck);myEmail=await whoami()}}
  if(myEmail)saveTokenCookie(localStorage.getItem('sxj_token'));
  paintComposer();
  loadWall();startWatch();
  window.addEventListener('scroll',function(){
    if(innerHeight+scrollY>=document.documentElement.scrollHeight-700)renderMore();
    const tt=$('toTop');if(tt)tt.style.display=scrollY>900?'block':'none';
  });
})();
document.addEventListener('click',function(e){var t=e.target;if(t&&t.classList&&t.classList.contains('wall-thumb')){e.preventDefault();e.stopPropagation();var L=document.getElementById('lightbox');document.getElementById('lightbox-img').src=t.src;L.style.display='flex'}});
</script>
</body>
