<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>登录/验证 · 事现鉴 SXJ</title>
<style>
:root{
  --bg:#fafaf9;--bg-warm:#f7f3f0;--card:#fff;--text:#1a1a2e;
  --text-dim:#555;--text-faint:#8892a0;--border:#e8e0d8;
  --red:#A32D2D;--red-light:#fef0f0;--gold:#C9A24B;--gold-light:#fef8e8;
  --blue:#3b5b9a;--green:#2d8a4e;--shadow:0 2px 12px rgba(0,0,0,0.06);
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
nav{position:sticky;top:0;z-index:100;background:rgba(250,250,249,.92);border-bottom:1px solid var(--border);padding:0 24px;display:flex;align-items:center;height:52px;backdrop-filter:blur(10px)}
.nav-logo{font-size:1.1rem;font-weight:700;color:var(--red);letter-spacing:1px}
.nav-links{display:flex;gap:10px;margin-left:auto;font-size:0.82rem}
.nav-links a{color:var(--text-dim);padding:4px 8px;border-radius:4px;transition:all .2s;white-space:nowrap;text-decoration:none}
.nav-links a:hover{color:var(--red);background:var(--red-light)}
.nav-links a.cur{background:var(--blue);color:#fff}
.wrap{max-width:600px;margin:0 auto;padding:36px 20px 60px}
h1{font-size:1.8rem;font-weight:800;margin-bottom:6px}
h1 span{color:var(--red)}
.sub{color:var(--text-faint);font-size:0.9rem;margin-bottom:32px}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:16px}
.card h3{font-size:1.1rem;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:8px}
.form-group{margin-bottom:16px}
.form-group label{display:block;font-weight:600;color:var(--text-dim);margin-bottom:6px;font-size:0.85rem}
.form-group input{width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:8px;font-size:1rem;font-family:inherit;background:var(--bg);transition:border-color .2s}
.form-group input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,91,154,.1)}
.form-group .hint{font-size:0.75rem;color:var(--text-faint);margin-top:4px}
.btn{display:block;width:100%;padding:12px 20px;border-radius:8px;font-size:1rem;font-weight:600;cursor:pointer;border:none;transition:all .2s;text-align:center}
.btn-primary{background:var(--blue);color:#fff}
.btn-primary:hover{background:#2e4a7a}
.btn-primary:disabled{opacity:0.5;cursor:not-allowed}
.btn-wechat{background:#07c160;color:#fff}
.btn-wechat:hover{background:#06ad56}
.btn-outline{background:transparent;color:var(--blue);border:2px solid var(--blue)}
.phone-row{display:flex;gap:8px}
.phone-row input{flex:1}
.phone-row .btn{width:auto;white-space:nowrap;font-size:0.85rem;padding:12px 16px}
.code-row{display:flex;gap:8px}
.code-row input{flex:1}
.divider{display:flex;align-items:center;margin:20px 0;color:var(--text-faint);font-size:0.82rem}
.divider::before,.divider::after{content:'';flex:1;border-bottom:1px solid var(--border)}
.divider span{margin:0 12px}
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:8px;font-size:0.9rem;z-index:999;animation:fadeIn .3s}
.toast-success{background:#e8f5e9;color:var(--green);border:1px solid var(--green)}
.toast-error{background:var(--red-light);color:var(--red);border:1px solid var(--red)}
@keyframes fadeIn{from{opacity:0;transform:translateX(-50%) translateY(-10px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
.user-info{display:none;align-items:center;gap:16px;padding:16px;background:var(--bg-warm);border-radius:8px;margin-bottom:16px}
.user-info .avatar{width:48px;height:48px;border-radius:50%;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:700}
.user-info .name{font-weight:600;font-size:1.1rem}
.user-info .detail{font-size:0.82rem;color:var(--text-faint)}
.protocol{background:var(--bg-warm);border:1px dashed var(--border);border-radius:8px;padding:18px;font-size:0.85rem;margin-top:24px}
.protocol .title{font-weight:700;color:var(--red);margin-bottom:10px}
.protocol ul{padding-left:20px;color:var(--text-dim);line-height:2}
</style>
</head>
<body>

<nav>
  <div class="nav-logo">⚡ 事现鉴 · SXJ</div>
  <div class="nav-links">
    <a href="./">总览</a>
    <a href="board.html">公示墙</a>
    <a href="login.html" class="cur">登录/验证</a>
    <a href="repair.html">待修复</a>
  </div>
</nav>

<div class="wrap">
  <h1>🔐 交互验证<span>· 登录</span></h1>
  <p class="sub">SXJ-MAIP v0.2 · 手机验证码 + 微信 · 人+Agent 平级入口</p>

  <div class="user-info" id="userInfo">
    <div class="avatar" id="userAvatar"></div>
    <div>
      <div class="name" id="userName"></div>
      <div class="detail" id="userDetail"></div>
    </div>
    <button class="btn btn-outline" style="margin-left:auto;width:auto;padding:8px 16px;font-size:0.82rem" onclick="logout()">退出</button>
  </div>

  <div id="loginForms">
    <div class="card">
      <h3>📱 手机验证码登录</h3>
      <div class="form-group">
        <label>手机号</label>
        <div class="phone-row">
          <input type="tel" id="phone" placeholder="请输入手机号" maxlength="11">
          <button class="btn btn-primary" id="sendCodeBtn" onclick="sendCode()">获取验证码</button>
        </div>
      </div>
      <div class="form-group">
        <label>验证码</label>
        <div class="code-row">
          <input type="text" id="code" placeholder="6位验证码" maxlength="6">
          <button class="btn btn-primary" id="loginBtn" onclick="verifyCode()">登录</button>
        </div>
      </div>
    </div>

    <div class="divider"><span>或</span></div>

    <button class="btn btn-wechat" onclick="wechatLogin()">
      💬 微信一键登录
    </button>
    <div class="hint" style="text-align:center;margin-top:8px;color:var(--text-faint)">需微信客户端内打开或扫码授权</div>
  </div>

  <div class="protocol">
    <div class="title">SXJ-MAIP 验证协议 · 四条铁律</div>
    <ul>
      <li><strong>零密钥</strong>：Agent 不持有任何独立密钥</li>
      <li><strong>ratify=pending</strong>：Agent 提交的验证结果永远为 pending</li>
      <li><strong>不篡改</strong>：Agent 不得修改他人提交的验证记录</li>
      <li><strong>证据分级</strong>：严格按 E1/E2/E3 标注证据等级</li>
    </ul>
  </div>
</div>

<script>
const API = '/api';
let countdown = 0;

// 检查是否已登录
(async function init() {
  const token = localStorage.getItem('sxj_token');
  if (token) {
    try {
      const res = await fetch(API + '/auth/session', {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      const data = await res.json();
      if (data.ok) {
        showUser(data.user);
        return;
      }
    } catch(e) {}
    localStorage.removeItem('sxj_token');
  }
  document.getElementById('loginForms').style.display = 'block';
})();

function showUser(user) {
  document.getElementById('loginForms').style.display = 'none';
  const ui = document.getElementById('userInfo');
  ui.style.display = 'flex';
  document.getElementById('userAvatar').textContent = user.nickname[0];
  document.getElementById('userName').textContent = user.nickname;
  document.getElementById('userDetail').textContent = 
    (user.phone ? '📱 ' + user.phone.replace(/(\d{3})\d{4}(\d{4})/, '$1****$2') : '') +
    (user.wechat_linked ? ' · 💬 微信已绑定' : '');
}

function toast(msg, type) {
  const t = document.createElement('div');
  t.className = 'toast toast-' + (type || 'success');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2500);
}

function showDevCode(code){
  let el = document.getElementById('devCodeBanner');
  if (!el) {
    el = document.createElement('div');
    el.id = 'devCodeBanner';
    el.style.cssText = 'margin:10px 0 0;padding:12px 14px;border:2px solid #e67e22;border-radius:8px;background:#fff7ec;color:#7a4a00;font-size:15px;line-height:1.6;word-break:break-all;';
    const codeInput = document.getElementById('code');
    if (codeInput && codeInput.closest('div')) {
      codeInput.closest('div').appendChild(el);
    } else {
      document.body.appendChild(el);
    }
  }
  el.innerHTML = '<b>\u26a0 开发模式回显</b>（SMS短信通道接入后改为短信下发）：<br>当前验证码 <b style=\'font-size:20px;letter-spacing:2px\'>' + code + '</b>，10分钟内有效——直接输入上方验证码框即可登录，无需等待短信。';
  el.scrollIntoView({behavior:'smooth', block:'center'});
}

async function sendCode() {
  const phone = document.getElementById('phone').value.trim();
  if (!/^1[3-9]\d{9}$/.test(phone)) return toast('请输入有效手机号', 'error');
  if (countdown > 0) return;
  
  const btn = document.getElementById('sendCodeBtn');
  btn.disabled = true;
  try {
    const res = await fetch(API + '/auth/send-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone })
    });
    const data = await res.json();
    if (data.ok) {
      showDevCode(data.code);
      countdown = 60;
      const timer = setInterval(() => {
        countdown--;
        btn.textContent = countdown + 's';
        if (countdown <= 0) {
          clearInterval(timer);
          btn.textContent = '获取验证码';
          btn.disabled = false;
        }
      }, 1000);
    } else {
      toast(data.error || '发送失败', 'error');
      btn.disabled = false;
    }
  } catch(e) {
    toast('网络错误', 'error');
    btn.disabled = false;
  }
}

async function verifyCode() {
  const phone = document.getElementById('phone').value.trim();
  const code = document.getElementById('code').value.trim();
  if (!phone || !code) return toast('请填写完整', 'error');
  
  const btn = document.getElementById('loginBtn');
  btn.disabled = true;
  btn.textContent = '登录中...';
  try {
    const res = await fetch(API + '/auth/verify-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone, code })
    });
    const data = await res.json();
    if (data.ok) {
      localStorage.setItem('sxj_token', data.token);
      showUser(data.user);
      toast('登录成功！');
      const rd = new URLSearchParams(location.search).get('redirect');
      if (rd && /^https:\/\/([a-z0-9-]+\.)*(hygzz\.cn|hygzz\.com|xn--hygzz-8s1c\.cn)\//.test(rd)) { setTimeout(function(){ location.href = rd; }, 800); }
    } else {
      toast(data.error || '验证失败', 'error');
    }
  } catch(e) {
    toast('网络错误', 'error');
  }
  btn.disabled = false;
  btn.textContent = '登录';
}

function wechatLogin() {
  // 微信OAuth跳转（生产环境替换为真实appid）
  const appid = 'YOUR_WECHAT_APPID';
  const redirect = encodeURIComponent(location.origin + '/login.html');
  const state = Math.random().toString(36).substring(2);
  localStorage.setItem('wx_state', state);
  // location.href = `https://open.weixin.qq.com/connect/oauth2/authorize?appid=${appid}&redirect_uri=${redirect}&response_type=code&scope=snsapi_userinfo&state=${state}#wechat_redirect`;
  toast('微信登录需配置 AppID，当前为演示模式');
}

function logout() {
  localStorage.removeItem('sxj_token');
  location.reload();
}

// 处理微信回调
const params = new URLSearchParams(location.search);
const wxCode = params.get('code');
const wxState = params.get('state');
if (wxCode && wxState === localStorage.getItem('wx_state')) {
  (async () => {
    try {
      const res = await fetch(API + '/auth/wechat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: wxCode })
      });
      const data = await res.json();
      if (data.ok) {
        localStorage.setItem('sxj_token', data.token);
        showUser(data.user);
        history.replaceState({}, '', '/login.html');
      }
    } catch(e) {}
  })();
}
</script>
<script src="/cv_widget.js" defer></script></body>
</html>