def forward_to_mailroom(claim):
    """转发到收发室 sxj-hub。失败只记日志，不抛异常、不阻断本地写入。"""
    try:
        payload = {k: v for k, v in claim.items() if not k.startswith('_')}
        # 不代填 received_baseline：该字段是投递方"主动确认已收到基准"的声明，
        # 服务端代填等于伪造同意；且会改变指纹，导致同一内容重复入库
        req = urllib.request.Request(
            MAILROOM_URL,
            data=json.dumps(payload, ensure_ascii=False).encode('utf-8'),
            headers={'Content-Type': 'application/json'},
            method='POST')
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read().decode('utf-8', 'ignore'))
    except Exception as e:
        return {'__forward_error__': str(e)[:200]}
# ===== 收发室转发 END =====

def atomic_write(filepath, data):
    dirname = os.path.dirname(filepath)
    fd, tmp_path = tempfile.mkstemp(suffix='.tmp', dir=dirname)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp_path, filepath)
    except Exception:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        raise

def backup_data():
    if not os.path.exists(DATA_FILE):
        return
    os.makedirs(BACKUP_DIR, exist_ok=True)
    ts = time.strftime('%Y%m%d_%H%M%S')
    backup_path = os.path.join(BACKUP_DIR, f'board_full_{ts}.json')
    shutil.copy2(DATA_FILE, backup_path)
    backups = sorted(os.listdir(BACKUP_DIR))
    while len(backups) > 100:
        os.unlink(os.path.join(BACKUP_DIR, backups.pop(0)))

# ===== C12 补校验 + 身份归一化（2026-08-31 光锥运维部）=====
MAX_CONTENT_LEN = 20000


def _content_of(claim):
    """提取 content 的可校验文本。content 为三态字段（dict/str/None），须分别处理。"""
    if not isinstance(claim, dict):
        return ''
    v = claim.get('content')
    if v is None:
        return ''
    if isinstance(v, dict):
        for k in ('text', 'body', 'title', 'msg'):
            if v.get(k):
                return str(v[k])
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, (list, tuple)):
        return json.dumps(v, ensure_ascii=False)
    return str(v)


def validate_claim(claim):
    """C12：返回 None 表示通过，否则返回错误说明。"""
    if not isinstance(claim, dict):
        return 'payload 必须是 JSON 对象'
    txt = _content_of(claim).strip()
    if not txt:
        return 'content 不得为空（C12）'
    if len(txt) > MAX_CONTENT_LEN:
        return 'content 超长，上限 %d 字符（当前 %d）' % (MAX_CONTENT_LEN, len(txt))
    return None


def _norm_identity(name):
    """归一化身份名：去括号内容（白玺(BAI XI) -> 白玺）、去席位后缀、去空白、转小写。"""
    if not name:
        return ''
    import re as _re
    s = str(name).strip().lower()
    s = _re.sub(r'[\(（][^\)）]*[\)）]', '', s)
    s = _re.sub(r'/席位\d+', '', s)
    s = _re.sub(r'\s+', '', s)
    return s


