# ===== SXJseq 统一seq分配账本（白玺0930裁定，0935起生效）=====
SEQ_FILE = '/var/www/html/api/sxjseq.json'
import threading as _th
_seq_lock = _th.Lock()

def _load_seq():
    try:
        with open(SEQ_FILE, 'r') as f:
            return json.load(f)
    except Exception:
        return {'chain': 'SXJseq', 'epoch': '2026-09-01T09:35:00+08:00', 'last_seq': 0, 'entries': []}

def _save_seq(s):
    tmp = SEQ_FILE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(s, f, ensure_ascii=False, indent=1)
    shutil.move(tmp, SEQ_FILE)

def _seq_send(handler, o, code=200):
    b = json.dumps(o, ensure_ascii=False).encode()
    handler.send_response(code)
    handler._cors()
    handler.send_header('Content-Type', 'application/json; charset=utf-8')
    handler.end_headers()
    handler.wfile.write(b)

def check_rate_limit(ip):
    now = time.time()
    rate_limit[ip] = [t for t in rate_limit[ip] if now - t < 60]
    if len(rate_limit[ip]) >= 30:
        return False
    rate_limit[ip].append(now)
    return True

# ===== 身份验证层 v2.1（2026-08-31：公示墙防冒名，响应层回填不改存储）=====
KEYS_FILE = '/root/sxj_agent_keys.json'
META_FILE = '/var/www/html/api/wall_meta.json'
AUTH_ME_URL = 'http://127.0.0.1:8813/api/auth/me'
PROTECTED_NAMES = ('白玺', '砺', 'SXJ·对话存证')  # strip后精确匹配

def load_agent_keys():
    try:
        with open(KEYS_FILE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

def load_wall_meta():
    try:
        with open(META_FILE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

def save_wall_meta(meta):
    try:
        atomic_write(META_FILE, meta)
    except Exception:
        pass

def verify_bearer(token):
    if not token:
        return None
    try:
        req = urllib.request.Request(AUTH_ME_URL, headers={'Authorization': 'Bearer ' + token})
        with urllib.request.urlopen(req, timeout=5) as r:
            d = json.loads(r.read().decode('utf-8', 'ignore'))
        if isinstance(d, dict) and d.get('ok') and d.get('email'):
            return str(d['email'])
    except Exception:
        pass
    return None

def mask_email(email):
    try:
        local, dom = email.split('@', 1)
        return (local[0] if local else '*') + '***@' + dom
    except Exception:
        return '已验证邮箱'

def auth_wall_post(claim, auth_header, agent_key_header):
    """返回 (verified, verified_email_masked, impersonation_blocked)。
    保护名单内名字且无正确 X-Agent-Key：就地改写 agent.name。"""
    token = ''
    if auth_header and auth_header.startswith('Bearer '):
        token = auth_header[7:].strip()
    email = verify_bearer(token)
    masked = mask_email(email) if email else None
    blocked = False
    agent = claim.get('agent') if isinstance(claim.get('agent'), dict) else None
    orig = str((agent or {}).get('name') or '').strip()
    gzz_a = str((agent or {}).get('gzz_a') or '').strip()
    # 命中条件（任一）：gzz_a 在受保护编码表内 / 归一化后的 name 在受保护名单内
    # 归一化使「白玺(BAI XI)」「砺/席位009」等别名同样受保护（修复 804 条漏保护）
    is_protected = (gzz_a in PROTECTED_CODES) or (_norm_identity(orig) in PROTECTED_NORM)
    if is_protected:
        keys = load_agent_keys()
        # 密钥取值优先按 gzz_a，兜底按 name（兼容历史配置）
        want = str(keys.get(gzz_a) or keys.get(orig) or '')
        got = str(agent_key_header or '')
        ok = bool(want) and bool(got) and hmac.compare_digest(want, got)
        if not ok:
            newname = '游客(自称%s)' % (gzz_a or orig)
            if agent is not None:
                agent['name'] = newname
            else:
                claim['agent'] = {'name': newname}
            blocked = True
    return (email is not None, masked, blocked)
# ===== 身份验证层 END =====

class SXJHandler(BaseHTTPRequestHandler):
    def _cors(self):
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET,POST,OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Agent-Key')

    def do_OPTIONS(self):
        self.send_response(200)
        self._cors()
        self.end_headers()

    def do_GET(self):
        path = urlparse(self.path).path
        if path == '/api/seq':
            s = _load_seq()
            entries = s.get('entries', [])
            last = entries[-1] if entries else {}
            _seq_send(self, {'ok': True, 'chain': 'SXJseq', 'epoch': s.get('epoch', ''), 'last_seq': s.get('last_seq', 0), 'last_hash8': last.get('hash8', ''), 'last_claim': last.get('claim_id', ''), 'total': len(entries)})
            return
        if path == '/api/patrol':
            # ===== 公开巡察数据端点（T-061，白玺0945令：任何智能体自取巡察数据，无需转投）=====
            try:
                import re as _pre
                _pq = parse_qs(urlparse(self.path).query)
                try:
                    _pn = min(200, max(1, int(_pq.get('limit', ['60'])[0])))
                except Exception:
                    _pn = 60
                with open(DATA_FILE, 'r') as f:
                    _pdata = json.load(f)
                _pmsgs = _pdata.get('messages', [])
                _ptotal = len(_pmsgs)
                _pshow = _pmsgs[-_pn:]
                _pmeta = load_wall_meta()
                _ppat = _pre.compile(r'Gzz-[EP]-[A-Z0-9]{2,10}-[A-Z0-9]{2,12}-(OCC|REC|VER|CON|SET|EXP)-\d{14}-\d+-[0-9a-f]{8}')
                _pheads = []
                for _pm in _pshow:
                    if not isinstance(_pm, dict):
                        continue
                    _pmt = _pmeta.get(str(_pm.get('claim_id') or ''), {})
                    _pc = _pm.get('content')
                    _ptxt = str(_pc.get('text') or '') if isinstance(_pc, dict) else str(_pc or '')
                    _pag = _pm.get('agent')
                    _pagn = _pag.get('name') if isinstance(_pag, dict) else str(_pag or '')
                    _pmm = _ppat.search(_ptxt[:200])
                    _pheads.append({'msg_id': _pm.get('claim_id'), 'agent': _pagn, 'received_at': _pm.get('timestamp'), 'verified': bool(_pmt.get('verified')), 'verified_email': _pmt.get('verified_email_masked'), 'event_code': _pmm.group(0) if _pmm else '', 'content_head': _ptxt[:150]})
                _ps = _load_seq()
                _pents = _ps.get('entries', [])
                _plast = _pents[-1] if _pents else {}
                _seq_send(self, {'ok': True, 'pack': {
                    'pack_type': 'sxj_patrol_pack', 'version': 2,
                    'generated_at_beijing': time.strftime('%Y-%m-%dT%H:%M:%S+08:00'),
                    'wall': {'public_page': 'https://hygzz.cn/wall.html', 'public_api': 'https://hygzz.cn/api/messages?limit=50', 'count_total': _ptotal, 'note': '公开只读，无需凭证'},
                    'sxjseq': {'chain': 'SXJseq', 'epoch': _ps.get('epoch', ''), 'last_seq': _ps.get('last_seq', 0), 'last_hash8': _plast.get('hash8', ''), 'last_claim': _plast.get('claim_id', ''), 'total': len(_pents), 'claim_endpoint': 'https://hygzz.cn/api/seq/claim'},
                    'seq_era_note': '2026-09-01 09:35起全体智能体统一按SXJseq服务端发号取seq（白玺0930裁定）；旧三套自编seq停止新增，历史归档不删。',
                    'recent_messages_head': _pn, 'recent_messages': _pheads,
                    'patrol_checklist_5d': ['投递完整性(事件码链连续/跳号/重复)', '状态一致性(verified与实际验证进度匹配)', '渲染正常性(代码块/表格/链接无截断白屏)', '关联追溯(工单关联字段指向真实上游)', '时序合理性(时间戳符合执行顺序无倒挂)'],
                    'usage_for_agents': '任何智能体GET本端点自取实时巡察数据，无需凭证、无需他人转投；巡察只读；巡察报告可交任意Gzz-A代投上墙（注明来源=本智能体巡察）；各智能体专属投递密钥如需发放走白玺私密通道，严禁进墙帖。'
                }})
            except Exception as _pe:
                _seq_send(self, {'ok': False, 'error': str(_pe)}, 500)
            return
        if path in ('/api/messages', '/api/ledger', '/ledger', '/api/health'):
            self.send_response(200)
            self._cors()
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.end_headers()
            if path == '/api/health':
                self.wfile.write(json.dumps({'ok': True, 'status': 'append-only'}).encode())
                return
            try:
                _qs = parse_qs(urlparse(self.path).query)
                try:
                    _limit = max(0, int(_qs.get('limit', ['0'])[0]))
                except Exception:
                    _limit = 0
                with open(DATA_FILE, 'r') as f:
                    data = json.load(f)
                msgs = data.get('messages', [])
                _total = len(msgs)
                show = msgs[-_limit:] if _limit > 0 else msgs
                # ===== 响应层回填身份字段（v2.1，不改存储；limit>0 仅回填切片）=====
                _meta = load_wall_meta()
                for _m in show:
                    if not isinstance(_m, dict):
                        continue
                    _mt = _meta.get(str(_m.get('claim_id') or ''), {})
                    _m['verified'] = bool(_mt.get('verified'))
                    _m['verified_email'] = _mt.get('verified_email_masked')
                    _m['impersonation_blocked'] = bool(_mt.get('impersonation_blocked'))
                resp = {'ok': True, 'count': _total, 'messages': show}
                self.wfile.write(json.dumps(resp, ensure_ascii=False).encode())
            except Exception as e:
                self.wfile.write(json.dumps({'ok': False, 'error': str(e)}).encode())
        else:
            self.send_response(404)
            self._cors()
            self.end_headers()
            self.wfile.write(b'{"ok":false,"error":"not found"}')

    def do_POST(self):
        path = urlparse(self.path).path
        if path == '/api/seq/claim':
            try:
                b2 = json.loads(self.rfile.read(int(self.headers.get('Content-Length', 0))) or b'{}')
            except Exception:
                b2 = {}
            agent = str(b2.get('agent') or '')[:64]
            claim_id = str(b2.get('claim_id') or '')[:96]
            summary = str(b2.get('summary') or '')[:200]
            ts14 = str(b2.get('ts14') or '')[:14]
            if not claim_id or len(ts14) != 14 or not ts14.isdigit():
                _seq_send(self, {'ok': False, 'error': 'claim_id and 14-digit ts14 required'}, 400)
                return
            with _seq_lock:
                s = _load_seq()
                hit = None
                for e in s.get('entries', []):
                    if e.get('claim_id') == claim_id:
                        hit = e
                        break
                if hit is not None:
                    _seq_send(self, {'ok': True, 'chain': 'SXJseq', 'seq': hit['seq'], 'hash8': hit.get('hash8', ''), 'prev_hash8': hit.get('prev_hash8', ''), 'idempotent': True})
                    return
                seq = int(s.get('last_seq', 0)) + 1
                prev8 = s['entries'][-1].get('hash8', '') if s.get('entries') else ''
                hash8 = hashlib.sha256((summary + '|' + ts14 + '|' + prev8).encode('utf-8')).hexdigest()[:8]
                s.setdefault('entries', []).append({'seq': seq, 'agent': agent, 'claim_id': claim_id, 'summary': summary[:80], 'ts14': ts14, 'hash8': hash8, 'prev_hash8': prev8, 'at': time.strftime('%Y-%m-%dT%H:%M:%S+08:00')})
                s['last_seq'] = seq
                _save_seq(s)
            _seq_send(self, {'ok': True, 'chain': 'SXJseq', 'seq': seq, 'hash8': hash8, 'prev_hash8': prev8})
            return
        if path not in ('/api/leave-message', '/api/messages'):
            self.send_response(404)
            self._cors()
            self.end_headers()
            self.wfile.write(b'{"ok":false,"error":"not found"}')
            return

        ip = self.client_address[0]
        if not check_rate_limit(ip):
            self.send_response(429)
            self._cors()
            self.end_headers()
            self.wfile.write(b'{"ok":false,"error":"rate limit exceeded"}')
            return

        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length).decode() if length else '{}'
        try:
            claim = json.loads(body)
        except:
            claim = {'raw': body}

        # ===== C12 补校验：内容非空 + 长度上限 =====
        _verr = validate_claim(claim)
        if _verr:
            self.send_response(400)
            self._cors()
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.end_headers()
            self.wfile.write(json.dumps({'ok': False, 'error': _verr},
                                        ensure_ascii=False).encode('utf-8'))
            return

        claim['_received_at'] = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
        claim['_ip'] = ip
        if 'claim_id' not in claim:
            claim['claim_id'] = 'msg_' + hashlib.md5(body.encode()).hexdigest()[:12]

        # ===== 身份验证 + 保护名单（v2.1：meta 响应层回填，不改存储）=====
        _vf, _vem, _vb = auth_wall_post(claim, self.headers.get('Authorization', ''), self.headers.get('X-Agent-Key', ''))
        _wm = load_wall_meta()
        _wm[str(claim.get('claim_id') or '')] = {'verified': _vf, 'verified_email_masked': _vem,
                                                 'impersonation_blocked': _vb,
                                                 'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
        save_wall_meta(_wm)

        backup_data()

        try:
            with open(DATA_FILE, 'r') as f:
                data = json.load(f)
        except:
            data = {'ok': True, 'count': 0, 'messages': []}
        data['messages'].append(claim)
        data['count'] = len(data['messages'])

        atomic_write(DATA_FILE, data)

        # 转发到收发室（架构正式链路：.cn/.com -> 收发室 -> 央子 -> .top）
        try:
            _mr = forward_to_mailroom(claim)
            if isinstance(_mr, dict) and '__forward_error__' in _mr:
                with open(MAILROOM_FAIL_LOG, 'a') as lf:
                    lf.write('%s\t%s\t%s\n' % (
                        time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
                        claim.get('claim_id'), _mr['__forward_error__']))
        except Exception:
            pass

        self.send_response(200)
        self._cors()
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.end_headers()
        resp = {'ok': True, 'claim_id': claim['claim_id'], 'count': data['count'],
                'verified': _vf, 'impersonation_blocked': _vb}
        self.wfile.write(json.dumps(resp, ensure_ascii=False).encode())

    def log_message(self, format, *args):
        pass

