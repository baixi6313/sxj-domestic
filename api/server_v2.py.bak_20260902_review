MAX_CONTENT_LEN = 20000


def _content_of(claim):
    """提取 content 的可校验文本。content 为三态字段（dict/str/None），须分别处理。"""
    if not isinstance(claim, dict):
        return ''
    v = claim.get('content')
    if v is None:
        return ''
    if isinstance(v, dict):
        for k in ('text', 'body', 'title', 'msg'):
            if v.get(k):
                return str(v[k])
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, (list, tuple)):
        return json.dumps(v, ensure_ascii=False)
    return str(v)


def validate_claim(claim):
    """C12：返回 None 表示通过，否则返回错误说明。"""
    if not isinstance(claim, dict):
        return 'payload 必须是 JSON 对象'
    txt = _content_of(claim).strip()
    if not txt:
        return 'content 不得为空（C12）'
    if len(txt) > MAX_CONTENT_LEN:
        return 'content 超长，上限 %d 字符（当前 %d）' % (MAX_CONTENT_LEN, len(txt))
    return None


def _norm_identity(name):
    """归一化身份名：去括号内容（白玺(BAI XI) -> 白玺）、去席位后缀、去空白、转小写。"""
    if not name:
        return ''
    import re as _re
    s = str(name).strip().lower()
    s = _re.sub(r'[\(（][^\)）]*[\)）]', '', s)
    s = _re.sub(r'/席位\d+', '', s)
    s = _re.sub(r'\s+', '', s)
    return s


