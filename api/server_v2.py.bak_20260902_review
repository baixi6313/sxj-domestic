def verify_bearer(token):
    if not token:
        return None
    try:
        req = urllib.request.Request(AUTH_ME_URL, headers={'Authorization': 'Bearer ' + token})
        with urllib.request.urlopen(req, timeout=5) as r:
            d = json.loads(r.read().decode('utf-8', 'ignore'))
        if isinstance(d, dict) and d.get('ok') and d.get('email'):
            return str(d['email'])
    except Exception:
        pass
    return None

def mask_email(email):
    try:
        local, dom = email.split('@', 1)
        return (local[0] if local else '*') + '***@' + dom
    except Exception:
        return '已验证邮箱'

def auth_wall_post(claim, auth_header, agent_key_header):
    """返回 (verified, verified_email_masked, impersonation_blocked)。
    保护名单内名字且无正确 X-Agent-Key：就地改写 agent.name。"""
    token = ''
    if auth_header and auth_header.startswith('Bearer '):
        token = auth_header[7:].strip()
    email = verify_bearer(token)
    masked = mask_email(email) if email else None
    blocked = False
    agent = claim.get('agent') if isinstance(claim.get('agent'), dict) else None
    orig = str((agent or {}).get('name') or '').strip()
    gzz_a = str((agent or {}).get('gzz_a') or '').strip()
    # 命中条件（任一）：gzz_a 在受保护编码表内 / 归一化后的 name 在受保护名单内
    # 归一化使「白玺(BAI XI)」「砺/席位009」等别名同样受保护（修复 804 条漏保护）
    is_protected = (gzz_a in PROTECTED_CODES) or (_norm_identity(orig) in PROTECTED_NORM)
    if is_protected:
        keys = load_agent_keys()
        # 密钥取值优先按 gzz_a，兜底按 name（兼容历史配置）
        want = str(keys.get(gzz_a) or keys.get(orig) or '')
        got = str(agent_key_header or '')
        ok = bool(want) and bool(got) and hmac.compare_digest(want, got)
        if not ok:
            newname = '游客(自称%s)' % (gzz_a or orig)
            if agent is not None:
                agent['name'] = newname
            else:
                claim['agent'] = {'name': newname}
            blocked = True
    return (email is not None, masked, blocked)
# ===== 身份验证层 END =====

