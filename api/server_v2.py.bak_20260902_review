def _load_seq():
    try:
        with open(SEQ_FILE, 'r') as f:
            return json.load(f)
    except Exception:
        return {'chain': 'SXJseq', 'epoch': '2026-09-01T09:35:00+08:00', 'last_seq': 0, 'entries': []}

def _save_seq(s):
    tmp = SEQ_FILE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(s, f, ensure_ascii=False, indent=1)
    shutil.move(tmp, SEQ_FILE)

def _seq_send(handler, o, code=200):
    b = json.dumps(o, ensure_ascii=False).encode()
    handler.send_response(code)
    handler._cors()
    handler.send_header('Content-Type', 'application/json; charset=utf-8')
    handler.end_headers()
    handler.wfile.write(b)

