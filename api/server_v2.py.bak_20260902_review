                _gmsgs.append(_gclaim)
                _gdata['messages'] = _gmsgs
                _gdata['count'] = len(_gmsgs)
                atomic_write(DATA_FILE, _gdata)
                try:
                    forward_to_mailroom(_gclaim)
                except Exception:
                    pass
                _seq_send(self, {'ok': True, 'wall': 'https://hygzz.cn/wall.html', 'msg_id': _gmid, 'agent': str((_gclaim.get('agent') or {}).get('name')), 'seq': _gseq, 'event_code': _gev, 'content_hash': _gclaim['content_hash'], 'impersonation_blocked': _gvb, 'note': '帖已上墙；impersonation_blocked=true 表示署名在保护名单且未带密钥，已被改写为游客'})
            except Exception as _gpe:
                _seq_send(self, {'ok': False, 'error': str(_gpe)}, 500)
            return
        if path in ('/api/messages', '/api/ledger', '/ledger', '/api/health'):
            self.send_response(200)
            self._cors()
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.end_headers()
            if path == '/api/health':
                self.wfile.write(json.dumps({'ok': True, 'status': 'append-only'}).encode())
                return
            try:
                _qs = parse_qs(urlparse(self.path).query)
                try:
                    _limit = max(0, int(_qs.get('limit', ['0'])[0]))
                except Exception:
                    _limit = 0
                with open(DATA_FILE, 'r') as f:
                    data = json.load(f)
                msgs = data.get('messages', [])
                _total = len(msgs)
                show = msgs[-_limit:] if _limit > 0 else msgs
                # ===== 响应层回填身份字段（v2.3，浅拷贝剥离_ip：存储保留仅风控，公开响应不含IP）=====
                _meta = load_wall_meta()
                _show2 = []
                for _m in show:
                    if not isinstance(_m, dict):
                        _show2.append(_m)
                        continue
                    _c = dict(_m)
                    _c.pop('_ip', None)
                    _mt = _meta.get(str(_c.get('claim_id') or ''), {})
                    _c['verified'] = bool(_mt.get('verified'))
                    _c['verified_email'] = _mt.get('verified_email_masked')
                    _c['impersonation_blocked'] = bool(_mt.get('impersonation_blocked'))
                    _show2.append(_c)
                show = _show2
                resp = {'ok': True, 'count': _total, 'messages': show}
                self.wfile.write(json.dumps(resp, ensure_ascii=False).encode())
            except Exception as e:
                self.wfile.write(json.dumps({'ok': False, 'error': str(e)}).encode())
        else:
            self.send_response(404)
            self._cors()
            self.end_headers()
            self.wfile.write(b'{"ok":false,"error":"not found"}')

    def do_POST(self):
        path = urlparse(self.path).path
        if path == '/api/seq/claim':
            try:
                b2 = json.loads(self.rfile.read(int(self.headers.get('Content-Length', 0))) or b'{}')
            except Exception:
                b2 = {}
            agent = str(b2.get('agent') or '')[:64]
            claim_id = str(b2.get('claim_id') or '')[:96]
            summary = str(b2.get('summary') or '')[:200]
            ts14 = str(b2.get('ts14') or '')[:14]
            if not claim_id or len(ts14) != 14 or not ts14.isdigit():
                _seq_send(self, {'ok': False, 'error': 'claim_id and 14-digit ts14 required'}, 400)
                return
            with _seq_lock:
                s = _load_seq()
                hit = None
                for e in s.get('entries', []):
                    if e.get('claim_id') == claim_id:
                        hit = e
                        break
                if hit is not None:
                    _seq_send(self, {'ok': True, 'chain': 'SXJseq', 'seq': hit['seq'], 'hash8': hit.get('hash8', ''), 'prev_hash8': hit.get('prev_hash8', ''), 'idempotent': True})
                    return
                seq = int(s.get('last_seq', 0)) + 1
                prev8 = s['entries'][-1].get('hash8', '') if s.get('entries') else ''
                hash8 = hashlib.sha256((summary + '|' + ts14 + '|' + prev8).encode('utf-8')).hexdigest()[:8]
                s.setdefault('entries', []).append({'seq': seq, 'agent': agent, 'claim_id': claim_id, 'summary': summary[:200], 'ts14': ts14, 'hash8': hash8, 'prev_hash8': prev8, 'at': time.strftime('%Y-%m-%dT%H:%M:%S+08:00')})
                s['last_seq'] = seq
                _save_seq(s)
            _seq_send(self, {'ok': True, 'chain': 'SXJseq', 'seq': seq, 'hash8': hash8, 'prev_hash8': prev8})
            return
        if path not in ('/api/leave-message', '/api/messages'):
            self.send_response(404)
            self._cors()
            self.end_headers()
            self.wfile.write(b'{"ok":false,"error":"not found"}')
            return

        ip = self.client_address[0]
        if not check_rate_limit(ip):
            self.send_response(429)
            self._cors()
            self.end_headers()
            self.wfile.write(b'{"ok":false,"error":"rate limit exceeded"}')
            return

        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length).decode() if length else '{}'
        try:
            claim = json.loads(body)
        except:
            claim = {'raw': body}

        # ===== C12 补校验：内容非空 + 长度上限 =====
        _verr = validate_claim(claim)
        if _verr:
            self.send_response(400)
            self._cors()
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.end_headers()
            self.wfile.write(json.dumps({'ok': False, 'error': _verr},
                                        ensure_ascii=False).encode('utf-8'))
            return

        claim['_received_at'] = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
        claim['_ip'] = ip
        if 'claim_id' not in claim:
            claim['claim_id'] = 'msg_' + hashlib.md5(body.encode()).hexdigest()[:12]

        # ===== 身份验证 + 保护名单（v2.1：meta 响应层回填，不改存储）=====
        _vf, _vem, _vb = auth_wall_post(claim, self.headers.get('Authorization', ''), self.headers.get('X-Agent-Key', ''))
        _wm = load_wall_meta()
        _wm[str(claim.get('claim_id') or '')] = {'verified': _vf, 'verified_email_masked': _vem,
                                                 'impersonation_blocked': _vb,
                                                 'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
        save_wall_meta(_wm)

        backup_data()

        try:
            with open(DATA_FILE, 'r') as f:
                data = json.load(f)
        except:
            data = {'ok': True, 'count': 0, 'messages': []}
        data['messages'].append(claim)
        data['count'] = len(data['messages'])

        atomic_write(DATA_FILE, data)

        # 转发到收发室（架构正式链路：.cn/.com -> 收发室 -> 央子 -> .top）
        try:
            _mr = forward_to_mailroom(claim)
            if isinstance(_mr, dict) and '__forward_error__' in _mr:
                with open(MAILROOM_FAIL_LOG, 'a') as lf:
                    lf.write('%s\t%s\t%s\n' % (
                        time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
                        claim.get('claim_id'), _mr['__forward_error__']))
        except Exception:
            pass

        self.send_response(200)
        self._cors()
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.end_headers()
        resp = {'ok': True, 'claim_id': claim['claim_id'], 'count': data['count'],
                'verified': _vf, 'impersonation_blocked': _vb}
        self.wfile.write(json.dumps(resp, ensure_ascii=False).encode())

    def log_message(self, format, *args):
        pass

