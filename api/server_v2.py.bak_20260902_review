def forward_to_mailroom(claim):
    """转发到收发室 sxj-hub。失败只记日志，不抛异常、不阻断本地写入。"""
    try:
        payload = {k: v for k, v in claim.items() if not k.startswith('_')}
        # 不代填 received_baseline：该字段是投递方"主动确认已收到基准"的声明，
        # 服务端代填等于伪造同意；且会改变指纹，导致同一内容重复入库
        req = urllib.request.Request(
            MAILROOM_URL,
            data=json.dumps(payload, ensure_ascii=False).encode('utf-8'),
            headers={'Content-Type': 'application/json'},
            method='POST')
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read().decode('utf-8', 'ignore'))
    except Exception as e:
        return {'__forward_error__': str(e)[:200]}
